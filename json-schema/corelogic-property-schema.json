{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/corelogic/main/json-schema/corelogic-property-schema.json",
  "title": "RESO Property",
  "description": "A RESO Data Dictionary 2.0 Property record as returned by the CoreLogic Trestle RESO Web API.",
  "type": "object",
  "required": ["ListingKey"],
  "properties": {
    "ListingKey": { "type": "string", "description": "Unique key identifying the listing." },
    "ListingId": { "type": "string", "description": "MLS-issued listing number visible to consumers." },
    "StandardStatus": { "type": "string", "description": "RESO normalized listing status (Active, Pending, Closed, etc.)." },
    "PropertyType": { "type": "string", "description": "RESO normalized property type (Residential, Land, Commercial, etc.)." },
    "PropertySubType": { "type": "string" },
    "ListPrice": { "type": "number" },
    "ClosePrice": { "type": "number" },
    "BedroomsTotal": { "type": "integer" },
    "BathroomsTotalInteger": { "type": "integer" },
    "LivingArea": { "type": "number" },
    "LotSizeArea": { "type": "number" },
    "YearBuilt": { "type": "integer" },
    "StreetNumber": { "type": "string" },
    "StreetName": { "type": "string" },
    "StreetSuffix": { "type": "string" },
    "City": { "type": "string" },
    "StateOrProvince": { "type": "string" },
    "PostalCode": { "type": "string" },
    "Country": { "type": "string" },
    "Latitude": { "type": "number" },
    "Longitude": { "type": "number" },
    "ListAgentKey": { "type": "string" },
    "ListOfficeKey": { "type": "string" },
    "ModificationTimestamp": { "type": "string", "format": "date-time" },
    "OriginatingSystemName": { "type": "string", "description": "Identifier of the originating MLS." },
    "UniversalParcelId": { "type": "string", "description": "RESO 2.0 Universal Parcel Identifier (UPI)." },
    "CLIP": { "type": "string", "description": "CoreLogic machine-learning property identifier." }
  }
}
